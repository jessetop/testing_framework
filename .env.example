# AWS Console Credentials
# See SETUP.md for instructions on creating the lab_tester IAM user
AWS_CONSOLE_URL=https://YOUR-ACCOUNT-ALIAS.signin.aws.amazon.com/console
AWS_ACCOUNT_ID=123456789012
AWS_USERNAME=lab_tester
AWS_PASSWORD=your-password-here
AWS_REGION=us-east-1

# Splunk - Lab 1
# Get fresh URL from splunk.com before each test run (expires in ~10 min)
# SPLUNK_DOWNLOAD_URL=https://download.splunk.com/products/splunk/releases/...
SPLUNK_ADMIN_PASSWORD=LabPassword123!

# Optional - Splunkbase auth (for app installation tests)
# SPLUNKBASE_USERNAME=your-splunk-email@example.com
# SPLUNKBASE_PASSWORD=your-splunk-password

# Test settings
HEADLESS=true
# Set to 'false' to see the browser during tests
